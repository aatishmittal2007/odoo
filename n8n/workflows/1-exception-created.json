{
  "name": "StockSense - Exception Created AI Analysis",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stocksense/exception-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "stocksense-exception-created"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "auth-check-cond",
              "leftValue": "={{ $json.headers['x-stocksense-webhook-secret'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "auth-check",
      "name": "Verify StockSense Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "url": "=http://backend:5000/api/ai/exceptions/{{ $('Webhook Trigger').item.json.body.data.exceptionId }}/summary",
        "sendAndWait": false,
        "method": "POST",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "trigger-ai-summary",
      "name": "Request AI Analysis from Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 220]
    },
    {
      "parameters": {
        "url": "http://backend:5000/api/integrations/n8n/callback",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-stocksense-webhook-secret",
              "value": "={{ $vars.N8N_WEBHOOK_SECRET || 'stocksense-n8n-webhook-secret-2026' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"STORE_AI_ANALYSIS\",\n  \"exceptionId\": \"{{ $('Webhook Trigger').item.json.body.data.exceptionId }}\",\n  \"aiAnalysis\": {{ JSON.stringify($json) }}\n}",
        "options": {}
      },
      "id": "callback-store-ai",
      "name": "Store AI Analysis in StockSense",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Verify StockSense Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify StockSense Secret": {
      "main": [
        [
          {
            "node": "Request AI Analysis from Backend",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Request AI Analysis from Backend": {
      "main": [
        [
          {
            "node": "Store AI Analysis in StockSense",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}

{
  "name": "StockSense - Scheduled Daily Inventory Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-daily-trigger",
      "name": "Daily 8 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://backend:5000/api/dashboard/control-tower",
        "method": "GET",
        "authentication": "none",
        "options": {}
      },
      "id": "fetch-overview-kpis",
      "name": "Fetch Overview KPIs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "url": "http://backend:5000/api/internal/automation/summaries",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-automation-secret",
              "value": "={{ $vars.INTERNAL_AUTOMATION_SECRET || 'stocksense-internal-automation-2026' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "store-daily-summary",
      "name": "Store Daily Summary in StockSense",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Daily 8 AM Trigger": {
      "main": [
        [
          {
            "node": "Fetch Overview KPIs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Overview KPIs": {
      "main": [
        [
          {
            "node": "Store Daily Summary in StockSense",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
